while True:
    age_user = input("Enter your age: ")
    try:
        age_user = int(age_user)
        if 0 < age_user <= 120 :
            print("Age saved in the file")
            break
        else:
            print("Input no valid. input>0 and input<= 120")
    except ValueError:
        print("Input invalid. Please enter a valid integer for age.")
